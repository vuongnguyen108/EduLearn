<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - EduLearn Admin</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <a asp-controller="Admin" asp-action="Index"
               class="admin-brand">
                <i class="bi bi-mortarboard-fill"></i>
                EduLearn
            </a>

            <a asp-controller="Admin" asp-action="Index"
               class="sidebar-link">
                <i class="bi bi-grid-1x2"></i>
                Dashboard
            </a>

            <a asp-controller="Admin" asp-action="Courses"
               class="sidebar-link">
                <i class="bi bi-journal-bookmark"></i>
                Khóa học
            </a>

            <a asp-controller="Admin" asp-action="Orders"
               class="sidebar-link">
                <i class="bi bi-receipt"></i>
                Đơn hàng
            </a>

            <div class="sidebar-bottom">
                <form asp-controller="Account" asp-action="Logout"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-link logout-link">
                        <i class="bi bi-box-arrow-right"></i>
                        Đăng xuất
                    </button>
                </form>
            </div>
        </aside>

        <main class="admin-main">
            <header class="admin-topbar">
                <div>
                    <div class="text-secondary small">EduLearn / Admin</div>
                    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                </div>

                <div class="admin-profile">
                    <i class="bi bi-person-circle fs-3"></i>
                    <div>
                        <div class="fw-semibold">
                            @User.Identity?.Name
                        </div>
                        <small class="text-secondary">Administrator</small>
                    </div>
                </div>
            </header>

            <section class="admin-content">
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
