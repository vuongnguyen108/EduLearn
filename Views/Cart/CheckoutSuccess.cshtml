
@model Nhom8.Models.Order

@{
    ViewData["Title"] = "Order Successful";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-5">
                    <i class="bi bi-check-circle-fill text-success"
                       style="font-size: 4rem;"></i>

                    <h2 class="fw-bold mt-3">Purchase Successful!</h2>

                    <p class="text-muted">
                        Your simulated payment has been completed.
                    </p>

                    <div class="text-start bg-light rounded p-4 my-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Order ID</span>
                            <strong>#@Model.OrderId</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Payment method</span>
                            <strong>@Model.PaymentMethod</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Payment status</span>
                            <span class="badge bg-success">
                                @Model.PaymentStatus
                            </span>
                        </div>

                        <div class="d-flex justify-content-between border-top pt-3 mt-3">
                            <span>Total paid (simulated)</span>
                            <strong class="text-primary">
                                @Model.TotalAmount.ToString("C0") 
                            </strong>
                        </div>
                    </div>

                    <h5 class="fw-bold text-start">Your Courses</h5>

                    @foreach (var detail in Model.OrderDetails)
                    {
                        <div class="d-flex justify-content-between
                                    border-bottom py-3 text-start gap-3">
                            <span>@detail.Course.CourseTitle</span>
                            <strong class="text-nowrap">
                                @detail.UnitPrice.ToString("C0") 
                            </strong>
                        </div>
                    }

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-primary mt-4">
                        Back to Home
                    </a>

                    <a asp-controller="Course"
                       asp-action="Index"
                       class="btn btn-outline-primary mt-4">
                        Explore More Courses
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
