@model IEnumerable<Nhom8.Models.Course>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý khóa học";
}

<div class="panel">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h5 mb-1">Danh sách khóa học</h2>
            <div class="text-secondary small">
                Tổng cộng @Model.Count() khóa học
            </div>
            <a asp-controller="Admin"
               asp-action="CreateCourse"
               class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Thêm khóa học
            </a>
        </div>
    </div>

    <form asp-controller="Admin" asp-action="Courses"
          method="get" class="row g-2 mb-4">

        <div class="col-12 col-md-6">
            <input type="text"
                   name="searchTerm"
                   value="@ViewBag.SearchTerm"
                   class="form-control"
                   placeholder="Tìm theo tên hoặc slug khóa học..." />
        </div>

        <div class="col-12 col-md-4">
            <select name="status" class="form-select">
                <option value="">Tất cả trạng thái</option>
                @foreach (string item in ViewBag.Statuses)
                {
                    if ((string?)ViewBag.SelectedStatus == item)
                    {
                        <option value="@item" selected>@item</option>
                    }
                    else
                    {
                        <option value="@item">@item</option>
                    }
                }
            </select>
        </div>

        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-search"></i> Tìm
            </button>
            <a asp-controller="Admin" asp-action="Courses"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Khóa học</th>
                    <th>Danh mục</th>
                    <th>Giá</th>
                    <th>Học viên</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-4">
                            Không tìm thấy khóa học phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td>@course.CourseId</td>
                            <td>
                                <div class="fw-semibold">@course.CourseTitle</div>
                                <small class="text-secondary">@course.Slug</small>
                            </td>
                            <td>@course.Category.CategoryName</td>
                            <td>
                                @if (course.DiscountPrice.HasValue)
                                {
                                    <div class="fw-semibold">
                                        @course.DiscountPrice.Value.ToString(
                                            "C0",
                                            System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                                    </div>
                                    <small class="text-secondary text-decoration-line-through">
                                        @course.Price.ToString(
                                            "C0",
                                            System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                                    </small>
                                }
                                else
                                {
                                    @course.Price.ToString(
                                        "C0",
                                        System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                                }
                            </td>
                            <td>@course.Enrollments.Count</td>
                            <td>
                                <span class="badge text-bg-secondary">
                                    @course.CourseStatus
                                </span>
                            </td>
                            <td>@course.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Admin"
                                       asp-action="EditCourse"
                                       asp-route-id="@course.CourseId"
                                       class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </a>

                                    <a asp-controller="Admin"
                                       asp-action="DeleteCourse"
                                       asp-route-id="@course.CourseId"
                                       class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
