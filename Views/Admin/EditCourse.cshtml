
@model Nhom8.ViewModels.AdminEditCourseViewModel

@{
    ViewData["Title"] = "Sửa khóa học";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Sửa khóa học</h3>
        <a asp-action="Courses" class="btn btn-outline-secondary">
            Quay lại
        </a>
    </div>

    <form asp-action="EditCourse"
          asp-route-id="@Model.CourseId"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="CourseId" type="hidden" />
        <input asp-for="Slug" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CourseTitle" class="form-label">
                Tên khóa học
            </label>
            <input asp-for="CourseTitle" class="form-control" />
            <span asp-validation-for="CourseTitle"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Mô tả
            </label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">
                Danh mục
            </label>
            <select asp-for="CategoryId"
                    asp-items="ViewBag.Categories"
                    class="form-select">
                <option value="">-- Chọn danh mục --</option>
            </select>
            <span asp-validation-for="CategoryId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Level" class="form-label">
                Cấp độ
            </label>
            <select asp-for="Level" class="form-select">
                <option value="">-- Chọn cấp độ --</option>
                <option value="Beginner">Beginner</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
            </select>
            <span asp-validation-for="Level"
                  class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Price" class="form-label">
                    Giá gốc ($)
                </label>
                <input asp-for="Price"
                       type="number"
                       min="0"
                       step="0.01"
                       class="form-control" />
                <span asp-validation-for="Price"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="DiscountPrice" class="form-label">
                    Giá ưu đãi ($)
                </label>
                <input asp-for="DiscountPrice"
                       type="number"
                       min="0"
                       step="0.01"
                       class="form-control" />
                <span asp-validation-for="DiscountPrice"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Language" class="form-label">
                Ngôn ngữ
            </label>
            <input asp-for="Language" class="form-control" />
        </div>

        <div class="mb-4">
            <label asp-for="ThumbnailUrl" class="form-label">
                Đường dẫn ảnh khóa học
            </label>
            <input asp-for="ThumbnailUrl" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Lưu thay đổi
        </button>

        <a asp-action="Courses"
           class="btn btn-outline-secondary">
            Hủy
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
